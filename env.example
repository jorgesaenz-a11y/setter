# Tu WhatsApp PERSONAL, con indicativo y sin signos (ej. 573001234567). Aquí te llegan las aprobaciones.
OWNER_PHONE=
# Si el agente te avisa de un identificador @lid tuyo, pégalo aquí.
OWNER_LID=

# Google Calendar: Configuración del calendario > "Dirección secreta en formato iCal"
CALENDAR_ICS_URL=

# IA: usa Anthropic (Claude) o Google (Gemini). Elige UNA.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FATHOM_API_KEY=

# Clave para ver el QR en el navegador (inventa una larga). Solo en la nube.
ADMIN_KEY=

AGENT_NAME=Lía
DEFAULT_COUNTRY_CODE=57
TZ_NAME=America/Bogota

# Agendas anteriores a esta fecha no reciben apertura (ya las contactaste a mano). Formato AAAA-MM-DD.
SKIP_OPENINGS_BEFORE=

# Modo seguro: todo en 0 = nada sale sin tu aprobación. Cambia a 1 de a uno, cuando confíes.
AUTO_OPENING=0
AUTO_REMINDER=0
AUTO_REPLY=0
AUTO_FOLLOWUP=0
AUTO_POSTSALE=0

# Pruebas sin WhatsApp ni IA reales
DRY_RUN=0
FAKE_AI=0
